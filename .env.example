# MySQL 8 / MariaDB bağlantısı. Kullanıcı adı ve şifredeki özel karakterler URL-encode edilmelidir (@ → %40, # → %23, / → %2F).
DATABASE_URL=mysql://kullanici:sifre@localhost:3306/veritabani_adi

# Yönetici girişi. Gerçek şifreyi asla commit etmeyin (en az 12 karakter, benzersiz).
ADMIN_USERNAME="ismailsemih"
ADMIN_PASSWORD="SET_A_UNIQUE_LONG_PASSWORD_BEFORE_DEPLOYMENT"

# İsteğe bağlı
# PORT=3000

# Nginx/Plesk gibi bir ters vekilin arkasında 1 yapın; böylece hız sınırları ve giriş kilidi
# gerçek ziyaretçi IP'sini kullanır. Vekil yoksa boş bırakın (X-Forwarded-For'a güvenilmez).
# TRUST_PROXY=1

# Cloudflare R2 medya depolama (paneldeki tüm görsel/video yüklemeleri). Kurulum: README → "Cloudflare R2 kurulumu".
# Değişkenler eksikse site yine açılır, yalnızca yükleme kapalı kalır. `npm run r2:check` ile doğrulayın.
R2_ACCOUNT_ID="hesap_kimligi"
R2_ACCESS_KEY_ID="erisim_anahtari_kimligi"
R2_SECRET_ACCESS_KEY="gizli_erisim_anahtari"
R2_BUCKET="bucket_adi"
# Bucket'a bağlı özel alan adı, sonda "/" olmadan. Yüklenen dosyaların adresi bu alan adıyla başlar
# ve İçerik Güvenlik Politikası'nda görsel/video kaynağı olarak izin alır.
MEDIA_BASE_URL="https://cdn.alanadin.com"
