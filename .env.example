# MySQL 8 / MariaDB bağlantısı. Kullanıcı adı ve şifredeki özel karakterler URL-encode edilmelidir (@ → %40, # → %23, / → %2F).
DATABASE_URL=mysql://kullanici:sifre@localhost:3306/veritabani_adi

# Yönetici girişi. Gerçek şifreyi asla commit etmeyin (en az 12 karakter, benzersiz).
ADMIN_USERNAME="ismailsemih"
ADMIN_PASSWORD="SET_A_UNIQUE_LONG_PASSWORD_BEFORE_DEPLOYMENT"

# İsteğe bağlı
# PORT=3000

# Nginx/Plesk gibi bir ters vekilin arkasında 1 yapın; böylece hız sınırları ve giriş kilidi
# gerçek ziyaretçi IP'sini kullanır. Vekil yoksa boş bırakın (X-Forwarded-For'a güvenilmez).
# TRUST_PROXY=1

# Medya dosyalarının sunulduğu ek adres (ör. R2/CDN alan adı). İçerik Güvenlik Politikası'na eklenir.
# MEDIA_BASE_URL="https://media.ornek.com"
