# Üretim (Plesk) ortam değişkenleri şablonu. Gerçek değerleri YALNIZCA sunucuda girin:
# Plesk → Node.js → "Custom environment variables" ya da uygulama kökünde izinleri kısıtlanmış (chmod 600) bir .env dosyası.
# Bu şablon gerçek değer içermez; gerçek değerleri asla commit etmeyin.

NODE_ENV=production
# Plesk genelde PORT'u kendisi verir; tanımlıysa onu kullanın. Elle vermeniz gerekirse örn. 3000.
PORT=3000
# Nginx arkasında zorunlu: hız sınırları ve giriş kilidi gerçek ziyaretçi IP'sini kullansın.
TRUST_PROXY=1

# MySQL 8 / MariaDB. Siteye özel bir veritabanı ve yalnızca ona yetkili ayrı bir kullanıcı kullanın.
# Kullanıcı adı ve şifredeki özel karakterler URL-encode edilmelidir (@ → %40, # → %23, / → %2F).
DATABASE_URL=mysql://DB_KULLANICI:DB_SIFRE@localhost:3306/DB_ADI

# Yönetici girişi (şifre en az 12 karakter, benzersiz). Değiştirmek için değeri güncelleyip uygulamayı yeniden başlatın.
ADMIN_USERNAME=YONETICI_KULLANICI_ADI
ADMIN_PASSWORD=EN_AZ_12_KARAKTERLIK_BENZERSIZ_SIFRE

# Cloudflare R2 medya depolama (README → "Cloudflare R2 kurulumu"). Doğrulama: npm run r2:check
R2_ACCOUNT_ID=R2_HESAP_KIMLIGI
R2_ACCESS_KEY_ID=R2_ERISIM_ANAHTARI_KIMLIGI
R2_SECRET_ACCESS_KEY=R2_GIZLI_ERISIM_ANAHTARI
R2_BUCKET=BUCKET_ADI
# Bucket'a bağlı özel alan adı, sonda "/" olmadan.
MEDIA_BASE_URL=https://cdn.ALANADIN.com

# Cloudflare Turnstile (README → "Cloudflare Turnstile kurulumu"). Üretimde SECRET olmadan iletişim ve bülten formları kapalıdır (503).
# Cloudflare'ın "her zaman geçer" test anahtarlarını üretimde KULLANMAYIN.
TURNSTILE_SITE_KEY=TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=TURNSTILE_SECRET_KEY

# Yedekleme (scripts/backup-db.mjs, cron ile). Klasör web köküne DIŞINDA olmalı; yedekler kişisel veri içerir.
BACKUP_DIR=/var/www/vhosts/ALANADIN.com/backups/ismail-semih
# Saklanacak yedek sayısı (varsayılan 14).
# BACKUP_KEEP=14
# MySQL 8'de "PROCESS yetkisi" hatası alırsanız: MYSQLDUMP_EXTRA_ARGS=--no-tablespaces
# MYSQLDUMP_EXTRA_ARGS=--no-tablespaces
